{
  // 本文件主要定义了通用 UI 的行为和显示内容
  // 可参考文档和示例添加更多您需要的功能
  // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
  // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
  "interface_version": 2,
  "name": "zjcsMAAtest",
  "description": "杖剑传说 多账号日常自动化（MaaFramework）。",
  "contact": "QQ群: 123456789",
  "license": "MIT",
  "welcome": "首次使用！欢迎使用 MAA!",
  // 填写项目地址和版本号可实现自动更新功能
  "github": "https://github.com/MaaXYZ/critical100641056/zjcsMAAtest",
  "version": "1.0.0",
  // Mirror酱为第三方分发服务，新项目默认关闭
  // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
  // "mirrorchyan_rid": "MaaXXX",
  // "mirrorchyan_multiplatform": true,
  "controller": [
    {
      "name": "安卓端",
      "type": "Adb",
      "display_short_side": 720 // 默认缩放分辨率的短边长度
    },
    {
      "name": "桌面端",
      "type": "Win32",
      "win32": {
        "class_regex": ".*",
        "window_regex": "Visual Studio",
        // 截图及控制方式，请根据项目实际情况修改
        // 文档: https://maafw.xyz/docs/2.4-ControlMethods
        "screencap": "PrintWindow", // 截图方式
        "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
        "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
      }
    }
  ],
  "resource": [
    {
      "name": "官服",
      "path": [
        "./resource"
      ]
    },
    {
      "name": "B 服",
      "path": [
        "./resource"
        // "./resource_bilibili"
      ]
    }
  ],
  // 可选的 agent 示例
  // "agent": {
  //     "child_exec": "python",
  //     "child_args": [
  //         "./agent/main.py"
  //     ]
  // },
  "task": [
    {
      "name": "商店购买",
      "entry": "start商店",
      "default_check": false,
      "description": "杂货+宝库，按折扣规则购买",
      "option": [ "商店刷新次数" ]

    },
    {
      "name": "素材秘境",
      "entry": "start秘境",
      "default_check": false,
      "description": "挖矿，默认精确挖10次金矿，慢一些。嫌慢可以直接开快速，会超一点，超的不多",
      "option": [ "矿洞选择", "挖矿次数选择" ]
    },
    {
      "name": "奇景委派",
      "entry": "start奇景委派"
    },
    {
      "name": "竞技场",
      "entry": "start竞技场"
    },
    {
      "name": "圣兽",
      "entry": "start圣兽"
    },
    {
      "name": "双影",
      "entry": "start双影"
    },
    {
      "name": "日常副本标准",
      "entry": "start日常副本标准",
      "default_check": false,
      "description": "日常副本按需求选择，不想打最新的可以选择打老版本深渊刷片，默认每天买2次打4次，S评分领取",
      "option": [ "副本选择" ]//可能还需要添加是否领取奖励，用于攒副本次数。
    },   
    {
      "name": "每日委托",
      "entry": "start每日委托"
    },
    {
      "name": "收取商城红点",
      "entry": "start收取商城红点"
    },
    {
      "name": "收取精彩活动红点",
      "entry": "start收取精彩活动红点"
    },
    {
      "name": "公会讨伐收菜",
      "entry": "start公会"
    }
  ],
  "option": {
    "商店刷新次数": {
      "type": "select",
      "label": "商店刷新次数",
      "default_case": "到4.8万停",
      "cases": [
        {
          "name": "到4.8万停",
          "label": "到4.8万停",
          "pipeline_override": {
            "refresh": { "max_hit": 5 }
          }
        },
        {
          "name": "到8万停",
          "label": "到8万停",
          "pipeline_override": {
            "refresh": { "max_hit": 6 }
          }
        },
        {
          "name": "到12万停",
          "label": "到12万停",
          "pipeline_override": {
            "refresh": { "max_hit": 7 }
          }
        }
      ]
    },


    "副本选择": {
      "type": "select",
      "label": "副本选择",
      "default_case": "副本选择_标准",
      "cases": [
        {
          "name": "当前最新副本",
          "label": "当前最新副本",
          "pipeline_override": {
            "副本选择": {
              "next": [ "副本选择_标准", "副本打完返回_1" ]
            }
          }
        },
        {
          "name": "君临之巢深渊",
          "label": "君临之巢深渊",
          "pipeline_override": {
            "副本选择": {
              "next": [ "副本选择君临", "副本打完返回_1" ]
            }
          }
        }
      ]
    },


    "矿洞选择": {
      "type": "select",
      "label": "矿洞选择",
      "default_case": "黄金矿洞",
      "cases": [
        {
          "name": "黄金矿洞",
          "label": "黄金矿洞",
          "pipeline_override": {
            "矿洞选择": {
              "next": [ "黄金矿洞" ]
            }
          }
        },
        {
          "name": "铁石矿洞",
          "label": "铁石矿洞",
          "pipeline_override": {
            "矿洞选择": {
              "next": [ "铁石矿洞" ]
            }
          }
        },
        {
          "name": "怪物洞窟",
          "label": "怪物洞窟",
          "pipeline_override": {
            "矿洞选择": {
              "next": [ "怪物洞窟" ]
            }
          }
        },
        {
          "name": "砂石矿洞",
          "label": "砂石矿洞",
          "pipeline_override": {
            "矿洞选择": {
              "next": [ "砂石矿洞" ]
            }
          }
        }
      ]
    },




    "挖矿次数选择": {
      "type": "select",
      "label": "挖矿次数选择",
      "default_case": "精确10次做日常",
      "cases": [
        {
          "name": "精确10次做日常",
          "label": "精确10次",
          "pipeline_override": {
            "挖矿次数选择": {
              "next": [ "精确10次做日常" ]
            }
          }
        },
        {
          "name": "快速完成略多于10次",
          "label": "快速完成",
          "pipeline_override": {
            "挖矿次数选择": {
              "next": [ "快速完成略多于10次" ]
            }
          }
        }
      ]
    }







  }
}
    
      
    
