  "option": {

    "桌面app名称": {
      "type": "input",
      "label": "桌面app名称",
      "description": "模拟器桌面进游戏流程里「检测账号角色名」节点要识别的游戏 app 名称，即模拟器桌面上该 app 显示的名字。可填单个名称；要同时兼容多个名称时用 | 分隔（OCR 的 expected 支持正则，多个名称等价于或匹配）。",
      "inputs": [
        {
          "name": "桌面app名称",
          "label": "桌面app名称",
          "description": "模拟器桌面上游戏 app 的显示名称。多个名称用 | 分隔，例如：A|B|C。",
          "default": "KuiperNova|桃|6哥|老李|杖剑传说",
          "pipeline_type": "string",
          "verify": "^.{1,60}$"
        }
      ],
      "pipeline_override": {
        "检测账号角色名": {
          "recognition": {
            "type": "OCR",
            "param": {
              "roi": [ 42, 389, 637, 178 ],
              "expected": [ "{桌面app名称}" ]
            }
          }
        }
      }
    },

    "服务器名称": {
      "type": "input",
      "label": "服务器名称",
      "description": "模拟器桌面进游戏流程里「选择服务器」「选择服务器1」两个节点要识别并点击的服务器名称。",
      "inputs": [
        {
          "name": "服务器名称",
          "label": "服务器名称",
          "description": "要进入的服务器名字，例如：缠结钱袋。",
          "default": "缠结钱袋",
          "pipeline_type": "string",
          "verify": "^.{1,20}$"
        }
      ],
      "pipeline_override": {
        "选择服务器": {
          "recognition": {
            "type": "OCR",
            "param": {
              "expected": [ "{服务器名称}" ]
            }
          }
        },
        "选择服务器1": {
          "recognition": {
            "type": "OCR",
            "param": {
              "expected": [ "{服务器名称}" ]
            }
          }
        }
      }
    },



    "送礼物大号设置": {
      "type": "input",
      "label": "送礼物大号设置",
      "inputs": [
        {
          "name": "大号1昵称",
          "label": "大号1昵称",
          "description": "送礼物逻辑节点里的大号1检测节点，会前往该昵称的好友主页。",
          "default": "KuiperNova",
          "pipeline_type": "string",
          "verify": "^.{1,20}$"
        },
        {
          "name": "大号2昵称",
          "label": "大号2昵称",
          "description": "送礼物逻辑节点里的大号2检测节点，会前往该昵称的好友主页。",
          "default": "酥脆酥脆可颂",
          "pipeline_type": "string",
          "verify": "^.{1,20}$"
        }
      ],
      "pipeline_override": {
        "大号1检测并前往": {
          "recognition": {
            "type": "And",
            "param": {
              "all_of": [
                {
                  "sub_name": "ocr_node",
                  "recognition": {
                    "type": "OCR",
                    "param": {
                      "expected": [ "{大号1昵称}" ]
                    }
                  }
                },
                {
                  "recognition": {
                    "type": "OCR",
                    "param": {
                      "roi": "ocr_node",
                      "roi_offset": [ -4, 63, 21, -1 ],
                      "expected": [ "今日访客：4", "今日访客：3", "今日访客：2", "今日访客：1", "今日访客：0" ]
                    }
                  }
                }
              ]
            }
          }
        },
        "大号2检测并前往": {
          "recognition": {
            "type": "And",
            "param": {
              "all_of": [
                {
                  "sub_name": "ocr_node",
                  "recognition": {
                    "type": "OCR",
                    "param": {
                      "expected": [ "{大号2昵称}" ]
                    }
                  }
                },
                {
                  "recognition": {
                    "type": "OCR",
                    "param": {
                      "roi": "ocr_node",
                      "roi_offset": [ -4, 63, 21, -1 ],
                      "expected": [ "今日访客：4", "今日访客：3", "今日访客：2", "今日访客：1", "今日访客：0" ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },


    "讨伐推送设置": {
      "type": "input",
      "label": "讨伐推送设置",
      "description": "「识别到已击败结束本次，等待8点」命中后，往 WxPusher 推一条消息。三个字段会在运行时替换进该节点的 Webhook 请求体——**节点本身不用在 MPE 里配 action**，override 会自动补上；推完仍照原样等 30 秒再走 next。凭据只存在 MFAA 各自的实例配置里（D:\\Software\\MFAAvalonia\\config\\instances），不进 git 仓库。appToken / UID 留空时请求会失败，但已用 on_error 兜到无副作用的节点，不会把任务判成失败。",
      "inputs": [
        {
          "name": "apptoken",
          "label": "appToken",
          "description": "WxPusher 后台 → 应用管理 → 应用信息 里的 appToken，形如 AT_xxxxxxxx。留空表示本实例不推送。",
          "default": "",
          "pipeline_type": "string",
          "verify": "^(AT_[A-Za-z0-9]+)?$",
          "pattern_msg": "appToken 应以 AT_ 开头，且只含字母和数字（也可以留空）"
        },
        {
          "name": "uid",
          "label": "UID",
          "description": "WxPusher 后台 → 用户管理 里的 UID，形如 UID_xxxxxxxx。只支持单个接收人。",
          "default": "",
          "pipeline_type": "string",
          "verify": "^(UID_[A-Za-z0-9]+)?$",
          "pattern_msg": "UID 应以 UID_ 开头，且只含字母和数字（也可以留空）"
        },
        {
          "name": "推送内容",
          "label": "推送内容",
          "description": "推送正文。想区分是哪台实例，就在这里写实例名，例如「老李：第一次讨伐的 BOSS 已击杀」。",
          "default": "第一次讨伐的 BOSS 已击杀",
          "pipeline_type": "string",
          "verify": "^[^\"\\\\{}]{0,120}$",
          "pattern_msg": "不能含英文双引号、反斜杠或花括号（会破坏 JSON），120 字以内"
        }
      ],
      "pipeline_override": {
        "识别到已击败结束本次，等待8点": {
          "action": {
            "type": "Custom",
            "param": {
              "custom_action": "WebhookAction",
              "custom_action_param": {
                "url": "https://wxpusher.zjiecode.com/api/send/message",
                "method": "POST",
                "content_type": "application/json",
                "body": "{\"appToken\":\"{apptoken}\",\"contentType\":1,\"uids\":[\"{uid}\"],\"content\":\"{推送内容}\"}"
              }
            }
          },
          "on_error": [ "推送失败_忽略" ]
        },
        "推送失败_忽略": {}
      }
    },


